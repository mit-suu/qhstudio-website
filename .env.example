# Public site URL, used for canonical links, sitemap and Open Graph.
# Empty: https://www.qhstudio.io.vn in production builds, http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# Base URL that holds <slug>.mp4 files.
# Empty: the Azure Blob container in production builds, /public/work in dev.
NEXT_PUBLIC_VIDEO_BASE_URL=
